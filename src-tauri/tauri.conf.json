{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeTray",
  "version": "0.1.0",
  "identifier": "io.github.guiroger.tubetray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TubeTray",
        "width": 340,
        "height": 460,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://i.ytimg.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Baixe vídeos do YouTube em MP4 pela bandeja",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "GuiRoger",
    "copyright": "© 2026 GuiRoger · MIT",
    "homepage": "https://tubetray.vercel.app/"
  }
}
