{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TubeTray",
        "width": 340,
        "height": 460,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
